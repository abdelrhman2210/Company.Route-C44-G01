@model CreateEmployeeDTO
@{
    ViewData["Title"] = "Update";
}

<h1>Update On Emp/@Model.Name Data</h1>

<div class="d-flex flex-column align-items-center mb-4">
    <div class="border border-3 border-light shadow-sm rounded-3 d-flex justify-content-center align-items-center"
         style="width: 150px; height: 150px; background-color: #f8f9fa;">
        <img src="~/Files/Images/@(Model.ImageName ?? "user.png")"
             alt="Employee Photo"
             style="max-width: 100%; max-height: 100%; object-fit: contain; object-position: center;" />
    </div>

</div>

<br />
<br /> 

<form asp-action="Update" enctype="multipart/form-data">
    <partial name="PartialViews/_CreateANDUpdatePartialView" />

    <input asp-for = "ImageName" hidden/>
    <div class="my-3">
        <input type="submit" value="Save" class="btn btn-success" />
        <a asp-action="Index" class="btn btn-outline-dark">Back To List</a>
    </div>
</form>

@section ValidationSection{
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}