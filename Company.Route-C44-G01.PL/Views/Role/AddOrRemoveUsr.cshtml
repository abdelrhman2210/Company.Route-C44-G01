@model List<UsersInroleDTO>



@{
    ViewData["Title"] = "AddOrRemoveUsr";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var roleID = ViewData["RoleId"] as string;
}

<form asp-action="AddOrRemoveUsr" asp-route-roleId="@roleID">
    @for (int i = 0; i < Model.Count; i++)
    {
        <div class="form-group">
            <input asp-for="@Model[i].IsSelected" />
            <label asp-for="@Model[i].IsSelected">@Model[i].UserName</label>
        </div>

            <input type="hidden" asp-for="@Model[i].UserId" />
            <input type="hidden" asp-for="@Model[i].UserName" />
        
    }

    <input type="submit" value="Update" class="btn btn-outline-warning" />
    <a asp-action="Edit" asp-route-id="@roleID" class="btn btn-outline-dark">Cancel</a>
</form>

